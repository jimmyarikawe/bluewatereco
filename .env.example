# Contact form → email via Resend (https://resend.com). Without it, production returns 503 and dev just logs.
RESEND_API_KEY=
CONTACT_TO=info@bluewatereco.com
CONTACT_FROM="Bluewater Eco Website <noreply@bluewatereco.com>"

# Newsletter → Mailchimp audience (the WordPress site used Mailchimp)
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
